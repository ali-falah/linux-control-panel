<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">

<policyconfig>

  <vendor>Control Panel</vendor>
  <vendor_url>https://github.com/your-org/linux-control-panel</vendor_url>

  <!--
    This file intentionally declares ONE privileged operation: the Control
    Panel's root helper `lcp-admin`. Generic root utilities (tee, sed, cp,
    mv, rm, chmod, chown, visudo, …) must NEVER be annotated here — an
    annotation does not itself grant permission, but it points pkexec at a
    custom action id, and action defaults usually replace polkit's stricter
    built-in defaults for that very program.

    The helper lives at the developer install path, or at the distro
    package path when it ships with the RPM/DEB. Both copies are the same
    root-owned binary (the runtime verifies ownership and mode before use).
  -->

  <!-- Developer hand-install path: /usr/local/libexec/lcp-admin -->
  <action id="com.controlpanel.helper.system">
    <description>Run the Control Panel administrator helper</description>
    <message>Authentication is required to run the Control Panel administrator helper</message>
    <icon_name>preferences-system</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <!-- deliberately identical to polkit's built-in exec default (no
           `keep`): the five-minute caching for wheel members is granted
           exclusively by the rules.d rule the helper itself installs -->
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/libexec/lcp-admin</annotate>
  </action>

  <!-- Package install path: /usr/bin/lcp-admin (RPM/DEB externalBin) -->
  <action id="com.controlpanel.helper.packaged">
    <description>Run the Control Panel administrator helper</description>
    <message>Authentication is required to run the Control Panel administrator helper</message>
    <icon_name>preferences-system</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/bin/lcp-admin</annotate>
  </action>

</policyconfig>
